# Database connection (PostgreSQL, Supabase, Neon, or Render Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI Provider Configuration (groq or gemini)
AI_PRIMARY_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Auth0 Authentication Configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://api.smarthire.com
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_MANAGEMENT_CLIENT_ID=your_management_client_id
AUTH0_MANAGEMENT_CLIENT_SECRET=your_management_client_secret

# Optional Remote Cloud Storage (Supabase Storage fallback to local storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=resumes
